{
  "name": "rysk-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client and trading daemon for Rysk V12 options on HyperEVM",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "rysk": "node src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:live": "RYSK_LIVE_TESTS=1 vitest run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:secrets"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "read": "^4.1.0",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
